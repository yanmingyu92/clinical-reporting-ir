{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanmingyu92/clinical-reporting-ir/tree/main/schema/execution_plan.schema.json",
  "title": "Modernized Framework Execution Plan",
  "description": "Schema for the execution plan generated by the orchestrator. Defines the ordered steps, parallel groups, and expected outputs. Subject to Gate 1 approval.",
  "type": "object",
  "required": [
    "plan_id",
    "study_id",
    "framework_version",
    "generated_at",
    "config_hashes",
    "execution_order"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "Unique plan identifier"
    },
    "study_id": {
      "type": "string",
      "description": "Study protocol identifier"
    },
    "framework_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by": {
      "type": "string",
      "description": "User who generated the plan"
    },
    "config_hashes": {
      "type": "object",
      "description": "SHA-256 hashes of all configuration files at plan generation time",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "execution_order": {
      "type": "array",
      "description": "Ordered execution groups. Groups execute sequentially; steps within a group can execute in parallel.",
      "items": {
        "type": "object",
        "required": [
          "group_id",
          "steps"
        ],
        "properties": {
          "group_id": {
            "type": "string"
          },
          "parallel": {
            "type": "boolean",
            "default": false,
            "description": "Whether steps in this group can execute in parallel"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "step_id",
                "report_id",
                "report_type",
                "phase"
              ],
              "properties": {
                "step_id": {
                  "type": "string"
                },
                "report_id": {
                  "type": "string",
                  "description": "Output identifier (e.g., T-14.1.1)"
                },
                "report_type": {
                  "type": "string",
                  "description": "Registry report type name"
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "adam",
                    "data",
                    "compute",
                    "ir",
                    "render"
                  ]
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Step IDs that must complete before this step"
                },
                "expected_outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Expected output files"
                }
              }
            }
          }
        }
      }
    }
  }
}
